      },
      {
        "value": "pending",
        "label": "Pending",
        "stage": "waiting"
      },
      {
        "value": "booked",
        "label": "Booked",
        "stage": "won"
      },
      {
        "value": "in-progress",
        "label": "In progress",
        "stage": "underway"
      },
      {
        "value": "declined",
        "label": "Declined",
        "stage": "lost"
      }
    ],
    "marks": true
  },
  "summary": {
    "all": {
      "agg": "sum",
      "column": "total"
    },
    "slices": [
      {
        "value": "pending",
        "measure": {
          "agg": "sum",
          "column": "total"
        },
        "note": "{count} awaiting reply"
      },
      {
        "value": "booked",
        "measure": {
          "agg": "sum",
          "column": "total"
        },
        "note": "{count} not started"
      },
      {
        "value": "in-progress",
        "measure": {
          "agg": "sum",
          "column": "total"
        },
        "note": "{count} underway"
      },
      {
        "value": "declined",
        "measure": {
          "agg": "sum",
          "column": "total"
        },
        "note": "{count}, by the client"
      }
    ],
    "insight": {
      "label": "Win rate",
      "explain": "Won ÷ decided, for the jobs your filters let through. Won is {booked} plus {in-progress}; decided adds {declined}. {draft} and {pending} jobs aren’t decided yet, so they don’t count."
    }
  },
  "search": {
    "columns": [
      "job",
      "client",
      "address",
      "city"
    ],
    "hint": "Search by client, job or address"
  },
  "dateRange": {
    "column": "created"
  },
  "filters": [
    {
      "column": "status",
      "pinned": true
    },
    {
      "column": "owner"
    },
    {
      "column": "created",
      "pinned": true
    },
    {
      "column": "total"
    },
    {
      "column": "city"
    },
    {
      "column": "source"
    }
  ],
  "sort": {
    "column": "modified",
    "dir": "desc"
  },
  "group": {
    "options": [
      "status",
      "owner",
      "city"
    ],
    "default": null
  },
  "views": [
    {
      "id": "all",
      "label": "All jobs",
      "icon": "list",
      "filters": {}
    },
