      "detail": "{address}",
      "leading": "avatar",
      "avatarFrom": "client"
    },
    {
      "key": "status",
      "label": "Status",
      "type": "status",
      "priority": 3
    },
    {
      "key": "owner",
      "label": "Owner",
      "type": "person",
      "priority": 5
    },
    {
      "key": "source",
      "label": "Source",
      "type": "category",
      "priority": 8,
      "hidden": true
    },
