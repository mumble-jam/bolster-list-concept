    {
      "field": "summary",
      "value": "KPIs: Missing documents",
      "why": "L-summary: KPIs, the default: what the intent's tasks act on."
    },
    {
      "field": "filters",
      "value": "Status, Type of work pinned",
      "why": "L-filters: the status (tasks are about statuses) and what tasks find rows by, pinned; kinds, people and the key figure after."
    },
    {
      "field": "sort",
      "value": "Vendor, A–Z",
      "why": "L-sort: what the intent says people look for first."
    },
    {
      "field": "views",
      "value": "Active vendors first",
      "why": "L-summary: the source opens filtered, so the page opens on that view; it's never a card."
    },
    {
      "field": "rowClick",
      "value": "open",
      "why": "L-row-click: the vendor has its own full-screen window (Edit); Quick look in the ··· menu."
    },
    {
      "field": "create.label",
      "value": "Add vendor",
      "why": "L-create: vendors are added to a list the business keeps."
    },
    {
      "field": "actions.byStatus",
      "value": "per status, from the model",
      "why": "Up to three steps in the record, most used first (the model's order); files, links to related records and the rest under More; what can't be undone last, in red (L-risky)."
    },
    {
      "field": "record.has",
      "value": "Vendor orders, Bills and expenses, Bid requests, Jobs",
      "why": "L-related: what points at a vendor in the model, linked from its record with a count."
    },
    {
      "field": "icons",
      "value": "from the vocabulary",
      "why": "L-icons: system/model/icons.json, by meaning, record, type, label or verb. Proposed, waiting for review: Request a bid: send, Make inactive: archive."
