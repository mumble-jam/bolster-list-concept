      "value": "none",
      "why": "L-slot: bid requests have no pictures, and are known by a trade, not a person or company."
    },
    {
      "field": "columns[key=request].detail",
      "value": "none",
      "why": "L-name-first: job has its own column, so it isn't repeated on the second line; on a phone, where the columns go, the row's bottom line shows it."
    },
    {
      "field": "columns",
      "value": "Budget, Status, Job, Due, Waiting on, Items, Vendors shown; Trade, Client, Bids back, Vendors on file, Sent hidden",
      "why": "L-priority: the key figure, the status, then what the intent says people look at, in order (lookAt); the model's other fields stay available, hidden."
    },
    {
      "field": "summary",
      "value": "lifecycle: Not sent, Waiting, Bids back (last 30 days)",
      "why": "L-summary: the page's tasks move bid requests through 2 statuses, so the summary is the lifecycle; endings count the last 30 days; each adds up budget, the key figure, its count beside."
    },
    {
      "field": "filters",
